# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# --- Database ---
# DB_MODE=atlas  -> real MongoDB Atlas (needs MONGO_URI)
# DB_MODE=memory -> temporary in-memory database for development/testing.
#                   Data is LOST when the server stops. It is NOT persistent storage.
DB_MODE=atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=carbon_guard

# --- JWT ---
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
# 1440 minutes = 24 hours. After that the user logs in again.
JWT_EXPIRE_MINUTES=1440

# --- First admin account (created on first start if it does not exist) ---
ADMIN_EMAIL=admin@carbonguard.com
ADMIN_PASSWORD=change-me-before-demo

# --- Files ---
UPLOAD_DIR=uploads
MAX_IMAGE_MB=8

# --- CORS: comma-separated origins allowed to call the API from a browser ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Login/register attempts allowed per IP address per minute ---
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- AI model (optional). Leave empty to use ../ai_model/weights/carbon_guard_mobilenetv2.onnx ---
# If no model file exists, AI verification reports "unavailable" and submissions go to manual review.
AI_MODEL_PATH=

# --- Reverse geocoding (OpenStreetMap Nominatim, needs internet) ---
GEOCODING_ENABLED=true
# Nominatim asks for a contact address in the User-Agent. Use a team email.
GEOCODING_CONTACT_EMAIL=

# --- Satellite evidence (optional) ---
# none       -> satellite evidence is reported as "not_configured"
# copernicus -> Sentinel-2 imagery from the Copernicus Data Space Ecosystem.
#               Create a free account at https://dataspace.copernicus.eu and an OAuth client
#               (see SETUP_GUIDE.md, section "Satellite").
SATELLITE_PROVIDER=none
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
